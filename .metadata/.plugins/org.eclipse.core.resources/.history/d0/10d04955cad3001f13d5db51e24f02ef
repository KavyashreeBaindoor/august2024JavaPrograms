package newYear2025;

public class IsnoPalindrome {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		
		int num=565;
		int rev=0;
		
		while(num>0) {
			
			int singleDigit=num%10;  
			rev=rev*10+singleDigit;  
			num=num/10; 
				
		}
		
		if(rev==num) {
			System.out.println("it is palindrome");
		}
		
		

	}

}
