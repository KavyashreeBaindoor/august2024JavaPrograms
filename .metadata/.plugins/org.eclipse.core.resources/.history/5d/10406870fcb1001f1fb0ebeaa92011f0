package RevisonDecember2024;

public class isPrime {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		int num=2;
		boolean flag=true;
		
		for(int i=2;i<num;i++) {
			if(num%i==0)
			{
				flag=false;
				}	
		}
		
		if(flag) {
			System.out.println("is prime");
		}else {
			System.out.println("not prime");
		}
		

	}

}
