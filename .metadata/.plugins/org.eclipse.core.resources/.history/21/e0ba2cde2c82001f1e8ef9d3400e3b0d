		String a="i am kavya";
		String rev="";
		
		
		
		char[] arr=a.toCharArray();
		System.out.println(Arrays.toString(arr));//[i,  , a, m,  , k, a, v, y, a]

		
		
	for(int i=1;i<=arr.length;i++) {
		
